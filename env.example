APP_ENV=development
SECRET_KEY=change-me-with-a-long-random-value
DATABASE_URL=postgresql+psycopg2://iddun_app:change-me@localhost:5432/iddun_dev
# Em produção no Render, aponte para o caminho do disco persistente.
UPLOAD_FOLDER=

# Google Calendar OAuth (Sprint 7)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5000/integracoes/google/callback
# Opcional: chave dedicada para criptografar tokens OAuth. Se vazia em dev, SECRET_KEY é derivada.
TOKEN_ENCRYPTION_KEY=
