APP_ENV=development
SECRET_KEY=change-me-with-a-long-random-value
DATABASE_URL=postgresql+psycopg2://iddun_app:change-me@localhost:5432/iddun_dev
# Em produção no Render, aponte para o caminho do disco persistente.
UPLOAD_FOLDER=

# Google Calendar OAuth (Sprint 7)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5000/integracoes/google/callback
# Opcional: chave dedicada para criptografar tokens OAuth. Se vazia em dev, SECRET_KEY é derivada.
TOKEN_ENCRYPTION_KEY=


# Storage de mídia
# Desenvolvimento: local
# Produção futura: provider de object storage será escolhido antes do lançamento.
MEDIA_STORAGE_BACKEND=local
UPLOAD_FOLDER=


# Rate limiting
# memory:// é suficiente no desenvolvimento com uma instância.
# Em produção multi-instância, usar storage compartilhado compatível.
RATELIMIT_STORAGE_URI=memory://


# E-mail transacional
# development: console
# produção: smtp depois de configurar o fornecedor escolhido
EMAIL_BACKEND=console
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true


# Identidade legal / privacidade
# Preencher obrigatoriamente antes do lançamento público.
LEGAL_ENTITY_NAME=IDDUN
PRIVACY_CONTACT_EMAIL=
