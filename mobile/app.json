{
  "expo": {
    "name": "mobile",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "O IDDUN acessa suas fotos para você adicionar imagens ao seu perfil profissional.",
          "cameraPermission": "O IDDUN usa sua câmera para você fotografar trabalhos e atualizar seu perfil profissional.",
          "microphonePermission": false,
          "colors": {
            "cropToolbarColor": "#0B0B0F",
            "cropToolbarIconColor": "#FFFFFF",
            "cropToolbarActionTextColor": "#6B2EFF",
            "cropBackButtonIconColor": "#FFFFFF",
            "cropBackgroundColor": "#0B0B0F"
          },
          "dark": {
            "colors": {
              "cropToolbarColor": "#0B0B0F",
              "cropToolbarIconColor": "#FFFFFF",
              "cropToolbarActionTextColor": "#6B2EFF",
              "cropBackButtonIconColor": "#FFFFFF",
              "cropBackgroundColor": "#0B0B0F"
            }
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
